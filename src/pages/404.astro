---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLink from '../components/SectionLink.astro';
---

<BaseLayout title="ページが見つかりません" description="お探しのページは見つかりませんでした。" noindex>
  <section class="nf frame" aria-labelledby="nf-title">
    <div class="nf__inner">
      <p class="nf__code mono">404 — PAGE NOT FOUND</p>
      <h1 id="nf-title" class="nf__title">この頁は、<br />見つかりませんでした。</h1>
      <p class="nf__text">落丁・乱丁のようです。号数やURLをお確かめのうえ、表紙かバックナンバーからお探しください。</p>
      <ul class="nf__links">
        <li><SectionLink href="/">表紙へ</SectionLink></li>
        <li><SectionLink href="/archive/">バックナンバーへ</SectionLink></li>
      </ul>
      <p class="nf__note">※ お取り替えはできません。</p>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: var(--space-9) 0;
  }

  .nf__inner {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7);
    border-block: 1.5px solid var(--ink);
  }

  .nf__code {
    font-size: var(--fs-xs);
    color: var(--shu-text);
  }

  .nf__title {
    font-size: clamp(1.5rem, 7.2vw, 4.25rem);
    line-height: 1.3;
  }

  .nf__text {
    max-inline-size: 32em;
  }

  .nf__links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  .nf__note {
    font-size: var(--fs-xs);
    color: var(--ink-2);
  }
</style>
