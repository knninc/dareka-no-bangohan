---
/**
 * 本棚。号を背表紙として並べる（古い号が左、新しい号と次号の空き棚が右）。
 * 並びは新しい号から（読み上げ順）、見た目は row-reverse で左右を入れ替える。
 * 横にあふれたときは、右端（新しい号）から見える。
 */
import type { Issue } from '../lib/issues';
import { issueUrl } from '../lib/issues';
import { genreById } from '../lib/genres';
import { pad3, dateDots } from '../lib/format';
import { tate } from '../lib/tate';

interface Props {
  issues: Issue[];
  /** 次号の空き棚を出す */
  showNext?: boolean;
}
const { issues, showNext = true } = Astro.props;
const nextVol = (issues[0]?.data.vol ?? 0) + 1;

// 背の幅を号数から決める（毎回同じ並びになるように）。高さはそろえる
const spineWidth = (vol: number) => 58 + ((vol * 37) % 5) * 5;
---

<div class="shelf" role="region" aria-label="背表紙の棚（横にスクロールできます）" tabindex="0">
  <ol class="shelf__row">
    {
      showNext && (
        <li class="spine spine--next" style={`--w:60px`} aria-hidden="true">
          <span class="spine__vol mono">{pad3(nextVol)}</span>
          <span class="spine__title tate">次の誰かを待っています</span>
        </li>
      )
    }
    {
      issues.map((issue) => {
        const { vol, title, genre, date } = issue.data;
        return (
          <li class="spine" data-genre={genre} style={`--w:${spineWidth(vol)}px`}>
            <a href={issueUrl(issue)}>
              <span class="spine__vol mono" aria-hidden="true">
                {pad3(vol)}
              </span>
              <span class="spine__title tate" set:html={tate(title)} />
              <span class="spine__foot" aria-hidden="true">
                <span class="spine__mark">{genreById(genre).mark}</span>
              </span>
              <span class="visually-hidden">
                VOL.{pad3(vol)}（{genreById(genre).name}・{dateDots(date)}）
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>
  <div class="shelf__board" aria-hidden="true"></div>
</div>

<style>
  .shelf {
    position: relative;
    overflow-x: auto;
    padding-block-start: var(--space-4);
    scrollbar-width: thin;
    scrollbar-color: var(--paper-3) transparent;
    --spine-h: 300px; /* 背の高さはそろえる */
    /* 横スクロールの起点を右端（新しい号）にする。中身は ltr に戻す */
    direction: rtl;
  }

  .shelf > * {
    direction: ltr;
  }

  .shelf:focus-visible {
    outline-offset: 6px;
  }

  .shelf__row {
    display: flex;
    flex-direction: row-reverse;
    align-items: flex-end;
    gap: 3px;
    list-style: none;
    inline-size: max-content;
    min-inline-size: 100%;
    min-block-size: 330px;
    padding-inline: 2px;
  }

  .shelf__row > :first-child {
    /* 冊数が少ないうちは左に寄せる（あふれたら 0 になり、右端から見える） */
    margin-inline-end: auto;
  }

  .shelf__board {
    position: sticky;
    inset-inline: 0;
    block-size: 10px;
    border-block-start: 1.5px solid var(--ink);
    background: repeating-linear-gradient(90deg, transparent 0 6px, color-mix(in srgb, var(--ink) 14%, transparent) 6px 7px);
  }

  .spine {
    flex: none;
    inline-size: var(--w);
    block-size: var(--spine-h);
  }

  .spine > a,
  .spine--next {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    block-size: 100%;
    padding: 12px 0 0;
    background: var(--paper-2);
    border: 1.5px solid var(--ink);
    border-block-end: 0;
    color: var(--ink);
    text-decoration: none;
    box-shadow: inset 4px 0 0 -2px color-mix(in srgb, var(--paper) 70%, transparent),
      inset -5px 0 0 -2px color-mix(in srgb, var(--ink) 10%, transparent);
    transition: translate 0.25s var(--ease);
  }

  .spine > a::before {
    /* 背の上部の色帯 */
    content: '';
    position: absolute;
    inset: 0 0 auto;
    block-size: 7px;
    background: var(--g);
  }

  .spine > a:hover,
  .spine > a:focus-visible {
    translate: 0 -10px;
    color: var(--ink);
  }

  .spine > a:focus-visible {
    outline-offset: -4px;
  }

  .spine__vol {
    margin-block-start: 6px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .spine__title {
    flex: 1;
    min-block-size: 0;
    margin-block: 10px;
    overflow: hidden;
    font-weight: 800;
    font-size: 0.9375rem;
    line-height: 1.2;
    letter-spacing: 0.08em;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .spine__foot {
    display: grid;
    place-items: center;
    inline-size: 100%;
    block-size: 46px;
    border-block-start: 1px solid var(--ink);
    background: var(--g);
  }

  .spine__mark {
    color: var(--paper);
    font-weight: 800;
    font-size: 1rem;
  }

  .spine.spine--next {
    block-size: var(--spine-h);
    background: transparent;
    border-style: dashed;
    border-color: color-mix(in srgb, var(--ink) 45%, transparent);
    color: var(--ink-3);
  }

  .spine--next .spine__title {
    font-weight: 500;
    font-size: 0.8125rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .spine > a {
      transition: none;
    }
  }
</style>
