---
/**
 * バックナンバー一覧（すべて／ジャンル別で共通）。
 * 年ごとにまとめ、号が増えても目次のように読めるようにする。
 */
import GenreMark from './GenreMark.astro';
import IssueRow from './IssueRow.astro';
import { GENRES, genreUrl, type Genre } from '../lib/genres';
import type { Issue } from '../lib/issues';

interface Props {
  all: Issue[];
  genre?: Genre;
}
const { all, genre } = Astro.props;
const issues = genre ? all.filter((i) => i.data.genre === genre.id) : all;

const years = [...new Set(issues.map((i) => i.data.date.getUTCFullYear()))].sort((a, b) => b - a);
const groups = years.map((y) => ({ year: y, issues: issues.filter((i) => i.data.date.getUTCFullYear() === y) }));
const counts = Object.fromEntries(GENRES.map((g) => [g.id, all.filter((i) => i.data.genre === g.id).length]));
---

<header class="archive-head frame" data-genre={genre?.id}>
  <div class="archive-head__inner">
    <p class="kicker">{genre ? `BACK NUMBERS — ${genre.en}` : 'BACK NUMBERS'}</p>
    <h1 class="archive-head__title">
      {
        genre ? (
          <>
            <GenreMark genre={genre.id} size="lg" />
            <span>「{genre.name}」の晩ごはん</span>
          </>
        ) : (
          <span>バックナンバー</span>
        )
      }
    </h1>
    <p class="archive-head__count">
      {genre ? '' : '全'}<span class="mono">{genre ? issues.length : all.length}</span>
      {genre ? `号（全${all.length}号のうち）` : '号'}
    </p>
    {
      genre && (
        <div class="archive-head__about">
          <p class="archive-head__lead">{genre.lead}</p>
          <p class="archive-head__rule">
            <span class="archive-head__rule-label">編集の約束</span>
            {genre.rule}
          </p>
        </div>
      )
    }
  </div>
</header>

<nav class="filter frame" aria-label="ジャンルで絞り込む">
  <ul class="filter__list">
    <li>
      <a href="/archive/" aria-current={!genre ? 'page' : undefined}>
        <span>すべて</span><span class="filter__n mono">{all.length}</span>
      </a>
    </li>
    {
      GENRES.map((g) => (
        <li data-genre={g.id}>
          <a href={genreUrl(g.id)} aria-current={genre?.id === g.id ? 'page' : undefined}>
            <GenreMark genre={g.id} />
            <span>{g.name}</span>
            <span class="filter__n mono">{counts[g.id]}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<section class="archive frame" aria-label={genre ? `${genre.name}の号の一覧` : '号の一覧'}>
  <div class="archive__inner">
    {
      years.length > 1 && (
        <nav class="years" aria-label="年">
          <ul>
            {years.map((y) => (
              <li>
                <a href={`#y${y}`} class="mono">
                  {y}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      groups.map((g) => (
        <section class="year" id={`y${g.year}`} aria-labelledby={`y${g.year}-title`}>
          <h2 class="year__title mono" id={`y${g.year}-title`}>
            {g.year}
          </h2>
          <ol class="year__list" reversed>
            {g.issues.map((issue) => (
              <li>
                <IssueRow issue={issue} />
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    {
      issues.length === 0 && genre && (
        <div class="empty">
          <p class="empty__title">この食卓の号は、まだありません。</p>
          <p class="empty__example">
            <span class="empty__tag">たとえば</span>
            {genre.example}
          </p>
          <p class="empty__note">※ テーマの例です。まだ開催した号ではありません。</p>
        </div>
      )
    }
  </div>
</section>

<style>
  .archive-head {
    padding-block: var(--space-7) var(--space-5);
  }

  .archive-head__inner {
    display: grid;
    gap: var(--space-4);
  }

  .archive-head__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--fs-3xl);
    line-height: 1.2;
    color: var(--g, var(--ink));
  }

  .archive-head__count {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }

  .archive-head__count .mono {
    margin-inline-end: 0.3em;
    font-size: var(--fs-lg);
    color: var(--ink);
  }

  .archive-head__about {
    display: grid;
    gap: var(--space-3);
    max-inline-size: 38rem;
    padding-block-start: var(--space-3);
  }

  .archive-head__lead {
    font-size: var(--fs-lg);
    font-weight: 800;
  }

  .archive-head__rule {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }

  .archive-head__rule-label {
    margin-inline-end: 0.8em;
    padding: 0 0.5em;
    border: 1px solid currentColor;
    font-family: var(--font-gothic);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
  }

  /* ---- 絞り込み ---- */
  .filter {
    position: sticky;
    top: 0;
    z-index: 5;
    background-color: var(--paper);
    background-image: var(--grain);
  }

  .filter__list {
    list-style: none;
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding-block: var(--space-3);
    border-block: 1.5px solid var(--ink);
    scrollbar-width: none;
  }

  .filter__list a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.45em 0.85em;
    border: 1px solid var(--rule);
    font-family: var(--font-gothic);
    font-weight: 500;
    font-size: var(--fs-sm);
    letter-spacing: 0.06em;
    line-height: 1.3;
    white-space: nowrap;
    text-decoration: none;
    background: var(--paper);
  }

  .filter__list a:focus-visible {
    outline-offset: -4px;
  }

  .filter__list a:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .filter__list a[aria-current='page'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .filter__list a[aria-current='page'] :global(.mark) {
    color: var(--paper);
    border-color: var(--paper);
  }

  .filter__n {
    font-size: 0.6875rem;
    opacity: 0.75;
  }

  /* ---- 年ごとの一覧 ---- */
  .archive__inner {
    display: grid;
    gap: var(--space-7);
    padding-block-start: var(--space-6);
  }

  .years ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .years a {
    font-size: var(--fs-sm);
  }

  .year {
    display: grid;
    gap: 0;
  }

  .year__title {
    font-size: var(--fs-xl);
    font-weight: 500;
    letter-spacing: 0.08em;
    padding-block-end: var(--space-2);
    border-block-end: 1px solid var(--ink);
  }

  .year__list {
    list-style: none;
  }

  .empty {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5);
    border: 1px dashed color-mix(in srgb, var(--ink) 45%, transparent);
  }

  .empty__title {
    font-size: var(--fs-lg);
    font-weight: 800;
  }

  .empty__example {
    display: flex;
    gap: var(--space-3);
    color: var(--ink-2);
  }

  .empty__tag {
    flex: none;
    align-self: flex-start;
    margin-block-start: 0.3em;
    padding: 0 0.5em;
    border: 1px dashed currentColor;
    font-family: var(--font-gothic);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    line-height: 1.6;
  }

  .empty__note {
    font-size: var(--fs-xs);
    color: var(--ink-2);
  }

  @media (min-width: 60rem) {
    .year {
      grid-template-columns: 9rem minmax(0, 1fr);
      column-gap: var(--space-6);
      align-items: start;
    }
    .year__title {
      position: sticky;
      top: 5rem;
      border-block-end: 0;
      border-block-start: 1.5px solid var(--ink);
      padding-block: var(--space-3) 0;
    }
    .year__list {
      border-block-start: 1px solid var(--ink);
    }
  }
</style>
