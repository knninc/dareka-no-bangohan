---
/**
 * 図版：五大栄養素と、その下に数える33項目。
 * 一項目 = 一マス。リソグラフの版ずれのように朱をずらして刷る。
 */
const rows = [
  { name: 'たんぱく質', n: 1 },
  { name: '脂質', n: 4 },
  { name: '炭水化物', n: 2 },
  { name: 'ビタミン', n: 13 },
  { name: 'ミネラル', n: 13 },
];
const total = rows.reduce((a, r) => a + r.n, 0);
---

<figure class="boxes">
  <ol class="boxes__list">
    {
      rows.map((r) => (
        <li class="boxes__row">
          <span class="boxes__name">{r.name}</span>
          <span class="boxes__cells" aria-hidden="true">
            {Array.from({ length: r.n }, () => (
              <span class="boxes__cell" />
            ))}
          </span>
          <span class="boxes__n mono">
            {r.n}
            <span class="visually-hidden">項目</span>
          </span>
        </li>
      ))
    }
  </ol>
  <p class="boxes__total">
    <span>あわせて</span><span class="boxes__total-n mono">{total}</span><span>項目</span>
  </p>
  <figcaption class="boxes__cap">五大栄養素の下に数える項目。一マスが一項目。水は入っていない。</figcaption>
</figure>

<style>
  .boxes {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--ink);
    background: color-mix(in srgb, var(--paper-2) 55%, transparent);
  }

  .boxes__list {
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }

  .boxes__row {
    display: grid;
    grid-template-columns: 4.8em 1fr auto;
    align-items: center;
    gap: var(--space-2);
  }

  .boxes__name {
    font-family: var(--font-gothic);
    font-size: var(--fs-sm);
    letter-spacing: 0.06em;
    line-height: 1.4;
  }

  .boxes__cells {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
  }

  .boxes__cell {
    inline-size: 0.72rem;
    block-size: 0.72rem;
    border: 1px solid var(--ink);
    /* 朱の版ずれ */
    box-shadow: 2px 2px 0 0 color-mix(in srgb, var(--shu) 70%, transparent);
  }

  .boxes__n {
    min-inline-size: 2ch;
    font-size: var(--fs-sm);
    text-align: end;
    color: var(--ink-2);
  }

  .boxes__total {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 0.4em;
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--ink);
    font-family: var(--font-gothic);
    font-size: var(--fs-sm);
    letter-spacing: 0.1em;
  }

  .boxes__total-n {
    font-size: 2.25rem;
    line-height: 1;
    color: var(--shu-text);
  }

  .boxes__cap {
    font-size: var(--fs-xs);
    line-height: 1.7;
    color: var(--ink-2);
  }


  @media (min-width: 48rem) {
    .boxes {
      padding: var(--space-5);
    }
    .boxes__row {
      grid-template-columns: 5.2em 1fr auto;
      gap: var(--space-3);
    }
    .boxes__cells {
      gap: 3px;
    }
    .boxes__cell {
      inline-size: 0.85rem;
      block-size: 0.85rem;
    }
  }
</style>
