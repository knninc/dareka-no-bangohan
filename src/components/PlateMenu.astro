---
/**
 * 写真がない号の「表紙」。皿と箸を線で描き、その上に献立を組む。
 * 写真の代わりに文字で食卓を見せる（AI画像は使わない）。
 */
interface Props {
  menu: { name: string; note?: string }[];
  label?: string;
  class?: string;
  idSuffix?: string;
}

const { menu, label = '今夜の献立', class: className } = Astro.props;
// ページ内で一意になるように、献立から決まるIDを作る（同じ献立を2回置くときは idSuffix を渡す）
const uid = `plate-${[...JSON.stringify(menu) + label + (Astro.props.idSuffix ?? '')]
  .reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7)
  .toString(36)}`;
const density = menu.length >= 5 ? 'dense' : menu.length <= 2 ? 'sparse' : 'normal';
---

<figure class:list={['plate', className]} data-density={density}>
  <svg class="plate__art" viewBox="0 0 400 470" aria-hidden="true" focusable="false">
    <defs>
      <pattern id={`${uid}-dots`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(30)">
        <circle cx="3.5" cy="3.5" r="1.05" style="fill: var(--ai)"></circle>
      </pattern>
    </defs>
    <!-- 朱の版ズレ -->
    <circle cx="205" cy="204" r="186" style="fill: none; stroke: var(--shu)" stroke-width="2.2" opacity="0.85"></circle>
    <!-- 縁の網点 -->
    <path
      d="M200 14a186 186 0 1 0 0.01 0zM200 56a144 144 0 1 1 -0.01 0z"
      fill={`url(#${uid}-dots)`}
      fill-rule="evenodd"
      opacity="0.42"></path>
    <!-- 墨の線 -->
    <circle cx="200" cy="200" r="186" style="fill: none; stroke: var(--ink)" stroke-width="1.6"></circle>
    <circle cx="200" cy="200" r="144" style="fill: var(--paper); stroke: var(--ink)" stroke-width="1.1"></circle>
    <circle cx="200" cy="200" r="132" style="fill: none; stroke: var(--ink)" stroke-width="0.6" stroke-dasharray="1.5 5" opacity="0.6"></circle>
    <!-- 箸と箸置き -->
    <g style="fill: var(--ink)">
      <path d="M44 438 L360 431 L360 437 L44 441 Z"></path>
      <path d="M44 449 L360 446 L360 452 L44 452 Z"></path>
    </g>
    <rect x="300" y="426" width="26" height="32" rx="9" style="fill: var(--shu)" opacity="0.9"></rect>
  </svg>

  <figcaption class="plate__menu">
    <span class="plate__label">{label}</span>
    <ol class="plate__items">
      {menu.map((m) => <li>{m.name}</li>)}
    </ol>
  </figcaption>
</figure>

<style>
  .plate {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 400 / 470;
    inline-size: 100%;
    margin: 0;
  }

  .plate__art {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
  }

  .plate__menu {
    position: absolute;
    inset-inline: 21%;
    inset-block-start: 0;
    block-size: 85.1%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3.2cqi;
    text-align: center;
  }

  .plate__label {
    display: block;
    font-family: var(--font-gothic);
    font-weight: 500;
    font-size: clamp(0.6875rem, 3.2cqi, 0.875rem);
    letter-spacing: 0.32em;
    color: var(--shu-text);
    padding-inline-start: 0.32em;
  }

  .plate__items {
    list-style: none;
    display: grid;
    gap: 1.6cqi;
    font-family: var(--font-mincho);
    font-weight: 800;
    font-size: clamp(0.875rem, 5.6cqi, 1.625rem);
    line-height: 1.3;
    letter-spacing: 0.02em;
    font-feature-settings: 'palt';
    word-break: auto-phrase;
    text-wrap: balance;
  }

  .plate__items li + li::before {
    content: '';
    display: block;
    inline-size: 1.1em;
    block-size: 1px;
    margin: 0 auto 1.6cqi;
    background: color-mix(in srgb, var(--ink) 50%, transparent);
  }

  .plate[data-density='dense'] .plate__items {
    font-size: clamp(0.75rem, 4.4cqi, 1.25rem);
    gap: 1cqi;
  }

  .plate[data-density='sparse'] .plate__items {
    font-size: clamp(1rem, 7.6cqi, 2rem);
  }
</style>
