---
/**
 * ふたりの食卓の写真。台所A・台所Bの両方があれば左右に並べる（通話画面のように）。
 */
import { Picture } from 'astro:assets';
import type { Issue } from '../lib/issues';
import { SITE, type KitchenId } from '../site.config';

interface Props {
  photos: Issue['data']['photos'];
}
const { photos } = Astro.props;
const kitchenIds = Object.keys(SITE.kitchens) as KitchenId[];
const byKitchen = kitchenIds.map((k) => ({ id: k, label: SITE.kitchens[k], photos: photos.filter((p) => p.kitchen === k) }));
const unassigned = photos.filter((p) => !p.kitchen);
const split = byKitchen.filter((k) => k.photos.length > 0).length >= 2;
---

{
  split ? (
    <div class="photoset photoset--split">
      {byKitchen
        .filter((k) => k.photos.length)
        .map((k) => (
          <section class="photoset__kitchen" aria-label={k.label}>
            <p class="photoset__label">
              <span class="photoset__dot" aria-hidden="true" />
              {k.label}
            </p>
            {k.photos.map((p) => (
              <figure>
                <Picture
                  src={p.src}
                  alt={p.alt}
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 60rem) 36rem, 50vw"
                  formats={['avif', 'webp']}
                  loading="lazy"
                />
                {p.caption && <figcaption>{p.caption}</figcaption>}
              </figure>
            ))}
          </section>
        ))}
    </div>
  ) : null
}

{
  (split ? unassigned : photos).length > 0 && (
    <div class="photoset photoset--grid">
      {(split ? unassigned : photos).map((p) => (
        <figure>
          <Picture
            src={p.src}
            alt={p.alt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 60rem) 48rem, 100vw"
            formats={['avif', 'webp']}
            loading="lazy"
          />
          {(p.caption || p.kitchen) && (
            <figcaption>
              {p.caption}
              {p.kitchen && <span class="photoset__who">{SITE.kitchens[p.kitchen as KitchenId]}</span>}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  )
}

<style>
  .photoset {
    display: grid;
    gap: var(--space-4);
  }

  .photoset + .photoset {
    margin-block-start: var(--space-5);
  }

  .photoset--split {
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    padding: 3px;
    background: var(--ink);
  }

  .photoset__kitchen {
    display: grid;
    align-content: start;
    gap: 3px;
    background: var(--paper);
  }

  .photoset__label {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.4em 0.7em;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-gothic);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
  }

  .photoset__dot {
    inline-size: 0.5em;
    block-size: 0.5em;
    border-radius: 50%;
    background: var(--shu);
  }

  .photoset--grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  figure {
    display: grid;
    gap: var(--space-2);
  }

  figure :global(img) {
    inline-size: 100%;
    block-size: auto;
    background: var(--paper-2);
  }

  /* 記録の写真は切り抜かず、元の比率のまま並べる */

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    padding-inline: 0.2em;
    font-family: var(--font-gothic);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .photoset--split figcaption {
    padding: 0 0.7em 0.6em;
  }

  .photoset__who {
    color: var(--ink-3);
  }
</style>
