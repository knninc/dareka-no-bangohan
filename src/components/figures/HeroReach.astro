---
/** 扉の図：「含まれている」≠「届いている」 */
---

<div class="hero" role="img" aria-label="食材に含まれている量と、身体に届いて役立つ量は、同じではない">
  <div class="hero__side">
    <span class="hero__small">食材に</span>
    <span class="hero__big">含まれている</span>
    <span class="hero__dots" aria-hidden="true">
      {Array.from({ length: 20 }, () => <span />)}
    </span>
  </div>
  <span class="hero__neq" aria-hidden="true">≠</span>
  <div class="hero__side hero__side--b">
    <span class="hero__small">身体に</span>
    <span class="hero__big">届いている</span>
    <span class="hero__dots hero__dots--few" aria-hidden="true">
      {Array.from({ length: 20 }, (_, i) => <span class:list={[i >= 9 && 'is-off']} />)}
    </span>
  </div>
</div>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--ink);
    background: color-mix(in srgb, var(--paper-2) 55%, transparent);
  }

  .hero__side {
    display: grid;
    gap: var(--space-1);
  }

  .hero__small {
    font-family: var(--font-gothic);
    font-size: var(--fs-sm);
    letter-spacing: 0.14em;
    color: var(--ink-2);
  }

  .hero__big {
    font-weight: 800;
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    line-height: 1.2;
    letter-spacing: 0.04em;
  }

  .hero__side--b .hero__big {
    color: var(--shu-text);
  }

  .hero__neq {
    font-family: var(--font-mono);
    font-size: 2.5rem;
    line-height: 1;
    color: var(--shu);
  }

  .hero__dots {
    display: grid;
    grid-template-columns: repeat(10, 0.75rem);
    gap: 4px;
    margin-block-start: var(--space-2);
  }

  .hero__dots span {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border-radius: 50%;
    background: var(--ink);
  }

  .hero__dots--few span {
    background: var(--shu);
  }

  .hero__dots--few span.is-off {
    background: transparent;
    border: 1px dashed var(--ink-2);
  }
</style>
