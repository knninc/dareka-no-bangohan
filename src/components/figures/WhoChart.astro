---
import FigFrame from './FigFrame.astro';
import { GROUPS, type Tier } from './balance';
/** 図：あなたはどの量？（食事バランスガイドの「適量チェック」） */
const tiers: { key: Tier; kcal: string; who: string[] }[] = [
  {
    key: 'low',
    kcal: '1,400〜2,000kcal',
    who: [
      '女性（12〜69歳）で、1日のほとんどを座って過ごす人',
      '70歳以上の女性',
      '70歳以上の男性で、1日のほとんどを座って過ごす人',
      '子ども（男の子6〜9歳、女の子6〜11歳）',
    ],
  },
  {
    key: 'base',
    kcal: '2,200±200kcal',
    who: [
      '女性（12〜69歳）で、座ってばかりではない人',
      '男性（12〜69歳）で、1日のほとんどを座って過ごす人',
      '70歳以上の男性で、座ってばかりではない人',
      '男の子（10〜11歳）',
    ],
  },
  {
    key: 'high',
    kcal: '2,400〜3,000kcal',
    who: ['男性（12〜69歳）で、座ってばかりではない人'],
  },
];
const TIER_NAME: Record<Tier, string> = { low: '少なめ', base: '基本形', high: '多め' };
---

<FigFrame
  no={3}
  title="あなたは、どの量？"
  caption="「食事バランスガイド」の適量チェックをもとに作成。「1日のほとんどを座って過ごす人」はガイドの「身体活動量が低い」人。子どもの牛乳・乳製品は、カルシウムを十分にとるため多めの幅が示されています。"
>
  <div class="who">
    {
      tiers.map((t) => (
        <section class:list={['who__tier', t.key === 'base' && 'is-base']}>
          <p class="who__head">
            <span class="who__name">{TIER_NAME[t.key]}</span>
            <span class="who__kcal mono">{t.kcal}</span>
          </p>
          <ul class="who__list">
            {t.who.map((w) => (
              <li>{w}</li>
            ))}
          </ul>
          <dl class="who__sv">
            {GROUPS.map((g) => (
              <div style={`--c:${g.color}`}>
                <dt>{g.short}</dt>
                <dd class="mono">{g.sv[t.key]}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }
  </div>
</FigFrame>

<style>
  .who {
    display: grid;
    gap: var(--space-3);
  }

  .who__tier {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-3) var(--space-4) var(--space-4);
    border: 1px solid var(--ink);
    background: var(--paper);
  }

  .who__tier.is-base {
    border-width: 2px;
    box-shadow: 4px 4px 0 0 color-mix(in srgb, var(--shu) 50%, transparent);
  }

  .who__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--space-3);
    padding-block-end: var(--space-2);
    border-block-end: 1px solid var(--ink);
  }

  .who__name {
    font-weight: 800;
    font-size: var(--fs-lg);
  }

  .is-base .who__name {
    color: var(--shu-text);
  }

  .who__kcal {
    font-size: var(--fs-xs);
    color: var(--ink-2);
  }

  .who__list {
    list-style: none;
    display: grid;
    gap: var(--space-1);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .who__list li {
    padding-inline-start: 1em;
    text-indent: -1em;
  }

  .who__list li::before {
    content: '・';
  }

  .who__sv {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2px;
    margin-block-start: var(--space-2);
  }

  .who__sv div {
    display: grid;
    justify-items: center;
    padding: var(--space-1) 0;
    background: var(--c);
    color: var(--paper);
  }

  .who__sv dt {
    font-family: var(--font-gothic);
    font-size: 0.5625rem;
    letter-spacing: 0;
    line-height: 1.3;
    text-align: center;
    word-break: keep-all;
  }

  .who__sv dd {
    font-size: var(--fs-sm);
    line-height: 1.4;
    white-space: nowrap;
  }

  @media (min-width: 60rem) {
    .who {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
