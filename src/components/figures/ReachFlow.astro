---
import FigFrame from './FigFrame.astro';
/** 図：食材から身体へ、5つの関門 */
const steps = [
  { label: '食べる', q: 'どれだけ食べたか', ex: 'しそ1枚と、成分表の「100gあたり」は大違い。', w: 100 },
  { label: '調理', q: '調理のあとに、どれだけ残ったか', ex: '水に溶けやすい成分は、ゆで汁に移ることがある。', w: 84 },
  { label: '吸収', q: 'どれだけ消化・吸収されたか', ex: '植物の鉄は、肉や魚の鉄より吸収されにくい。', w: 64 },
  { label: '利用', q: '身体の中で、どう使われたか', ex: 'エネルギーが足りないと、たんぱく質が材料に回りにくい。', w: 50 },
];
---

<FigFrame no={1} title="食材から身体へ。栄養素がくぐる関門" caption="帯の長さは説明のための模式で、実際の割合を示すものではありません。">
  <ol class="flow">
    {
      steps.map((s, i) => (
        <li class="flow__step">
          <span class="flow__no mono">{i + 1}</span>
          <div class="flow__main">
            <p class="flow__label">
              <strong>{s.label}</strong>
              <span>{s.q}</span>
            </p>
            <span class="flow__bar" style={`--w:${s.w}%`} aria-hidden="true" />
            <p class="flow__ex">{s.ex}</p>
          </div>
        </li>
      ))
    }
    <li class="flow__step flow__step--last">
      <span class="flow__no mono">5</span>
      <div class="flow__main">
        <p class="flow__label">
          <strong>判定</strong>
          <span>それで、足りないのか、多すぎるのか</span>
        </p>
        <p class="flow__scale" aria-hidden="true">
          <span class="flow__scale-l">不足</span>
          <span class="flow__scale-mid">ちょうどいい幅</span>
          <span class="flow__scale-r">過剰</span>
        </p>
        <p class="flow__ex">不足だけでなく、摂りすぎの側からも見る。</p>
      </div>
    </li>
  </ol>
</FigFrame>

<style>
  .flow {
    list-style: none;
    display: grid;
    gap: var(--space-4);
  }

  .flow__step {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--space-3);
  }

  .flow__no {
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-size: var(--fs-sm);
  }

  .flow__step--last .flow__no {
    background: var(--shu-text);
  }

  .flow__main {
    display: grid;
    gap: var(--space-2);
    min-inline-size: 0;
  }

  .flow__label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-3);
    line-height: 1.5;
  }

  .flow__label strong {
    font-size: var(--fs-lg);
  }

  .flow__label span {
    font-family: var(--font-gothic);
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }

  .flow__bar {
    display: block;
    inline-size: var(--w);
    block-size: 0.9rem;
    background:
      repeating-linear-gradient(135deg, transparent 0 5px, color-mix(in srgb, var(--paper) 35%, transparent) 5px 7px),
      var(--ai);
    box-shadow: 3px 3px 0 0 color-mix(in srgb, var(--shu) 55%, transparent);
  }

  .flow__ex {
    font-size: var(--fs-sm);
    line-height: 1.7;
  }

  .flow__scale {
    display: grid;
    grid-template-columns: 1fr 1.6fr 1fr;
    font-family: var(--font-gothic);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-align: center;
    line-height: 1.9;
  }

  .flow__scale-l,
  .flow__scale-r {
    border: 1px solid var(--shu-text);
    color: var(--shu-text);
  }

  .flow__scale-mid {
    background: var(--ai);
    color: var(--paper);
  }
</style>
