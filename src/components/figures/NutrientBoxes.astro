---
import FigFrame from './FigFrame.astro';
/** 図：五大栄養素と、その下に数える33項目 */
const groups = [
  {
    role: 'おもにエネルギーになる',
    note: '三大栄養素',
    rows: [
      { name: 'たんぱく質', items: ['たんぱく質'] },
      { name: '脂質', items: ['脂質', '飽和脂肪酸', 'n-3系脂肪酸', 'n-6系脂肪酸'] },
      { name: '炭水化物', items: ['炭水化物', '食物繊維'] },
    ],
  },
  {
    role: '少しの量で、身体の働きを支える',
    note: '',
    rows: [
      { name: 'ビタミン', items: ['A', 'D', 'E', 'K', 'B1', 'B2', 'B6', 'B12', 'ナイアシン', 'パントテン酸', 'ビオチン', '葉酸', 'C'] },
      { name: 'ミネラル', items: ['Na', 'K', 'Ca', 'Mg', 'P', 'Fe', 'Zn', 'Cu', 'Mn', 'I', 'Se', 'Cr', 'Mo'] },
    ],
  },
];
/** 「増やせばいい」とは言えない項目 */
const caution = new Set(['飽和脂肪酸', 'Na', 'Cr']);
const total = groups.flatMap((g) => g.rows).reduce((a, r) => a + r.items.length, 0);
---

<FigFrame
  no={2}
  title="五大栄養素と、その下の「33項目」"
  caption="一マスが一項目。朱の枠は「増やせばいい」とは言えない項目の例（飽和脂肪酸、ナトリウム、必須かどうか議論のあるクロム）。水はこの33に入っていない。"
>
  <div class="nb">
    {
      groups.map((g) => (
        <section class="nb__group">
          <p class="nb__role">
            {g.role}
            {g.note && <span class="nb__note">（{g.note}）</span>}
          </p>
          <ul class="nb__rows">
            {g.rows.map((r) => (
              <li class="nb__row">
                <span class="nb__name">{r.name}</span>
                <span class="nb__cells">
                  {r.items.map((it) => (
                    <span class:list={['nb__cell', caution.has(it) && 'is-caution']}>{it}</span>
                  ))}
                </span>
                <span class="nb__n mono">{r.items.length}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <p class="nb__total">
      <span>あわせて</span><span class="nb__total-n mono">{total}</span><span>項目</span>
    </p>
  </div>
</FigFrame>

<style>
  .nb {
    display: grid;
    gap: var(--space-4);
  }

  .nb__group {
    display: grid;
    gap: var(--space-2);
  }

  .nb__role {
    font-family: var(--font-gothic);
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    color: var(--ink-2);
  }

  .nb__note {
    letter-spacing: 0.04em;
  }

  .nb__rows {
    list-style: none;
    display: grid;
    gap: var(--space-2);
    padding-inline-start: var(--space-3);
    border-inline-start: 2px solid var(--ink);
  }

  .nb__row {
    display: grid;
    grid-template-columns: 4.6em 1fr 1.6em;
    gap: var(--space-2);
    align-items: start;
  }

  .nb__name {
    font-weight: 800;
    font-size: var(--fs-md);
    line-height: 1.6;
  }

  .nb__cells {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
  }

  .nb__cell {
    padding: 0.05em 0.4em;
    border: 1px solid var(--ink);
    background: var(--paper);
    font-family: var(--font-gothic);
    font-size: 0.6875rem;
    line-height: 1.6;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .nb__cell.is-caution {
    border-color: var(--shu-text);
    color: var(--shu-text);
    border-style: dashed;
  }

  .nb__n {
    font-size: var(--fs-sm);
    color: var(--ink-2);
    text-align: end;
    line-height: 1.8;
  }

  .nb__total {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 0.4em;
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--ink);
    font-family: var(--font-gothic);
    font-size: var(--fs-sm);
    letter-spacing: 0.1em;
  }

  .nb__total-n {
    font-size: 2.25rem;
    line-height: 1;
    color: var(--shu-text);
  }
</style>
