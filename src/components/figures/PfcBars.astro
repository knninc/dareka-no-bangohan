---
import FigFrame from './FigFrame.astro';
/**
 * 図：PFCは「重さ」の割合ではない。
 * 1日2,000kcal、P17%・F25%・C58% の例（解説書 2-2 の計算例）。
 */
const KCAL = 2000;
const parts = [
  { key: 'p', name: 'たんぱく質', short: 'P', pct: 17, per: 4 },
  { key: 'f', name: '脂質', short: 'F', pct: 25, per: 9 },
  { key: 'c', name: '炭水化物', short: 'C', pct: 58, per: 4 },
].map((p) => ({ ...p, g: (KCAL * p.pct) / 100 / p.per }));
const totalG = parts.reduce((a, p) => a + p.g, 0);
const withW = parts.map((p) => ({ ...p, wPct: (p.g / totalG) * 100 }));
const fmtG = (g: number) => (Number.isInteger(g) ? `${g}g` : `約${Math.round(g)}g`);
---

<FigFrame
  no={3}
  title="同じ食事でも、「エネルギー」で見るか「重さ」で見るかで、こんなにちがう"
  caption="1日2,000kcalを、たんぱく質17%・脂質25%・炭水化物58%で摂る場合の計算例。1gあたり、たんぱく質4kcal・脂質9kcal・炭水化物約4kcalで換算。食品成分表の表示値とは一致しないことがあります。"
>
  <div class="pfc">
    <ul class="pfc__per" aria-label="1gあたりのエネルギー">
      {
        parts.map((p) => (
          <li data-k={p.key}>
            <span class="pfc__chip">{p.short}</span>
            <span>{p.name}</span>
            <span class="pfc__per-n mono">1g = {p.key === 'c' ? '約' : ''}{p.per}kcal</span>
          </li>
        ))
      }
    </ul>

    <div class="pfc__row">
      <p class="pfc__label">エネルギー（kcal）の割合</p>
      <div class="pfc__bar" aria-hidden="true">
        {withW.map((p) => <span data-k={p.key} style={`--w:${p.pct}%`}>{p.short} {p.pct}%</span>)}
      </div>
    </div>

    <div class="pfc__row">
      <p class="pfc__label">重さ（g）の割合</p>
      <div class="pfc__bar" aria-hidden="true">
        {withW.map((p) => <span data-k={p.key} style={`--w:${p.wPct}%`}>{p.short} {Math.round(p.wPct)}%</span>)}
      </div>
    </div>

    <table class="pfc__table">
      <thead>
        <tr><th scope="col"></th><th scope="col">エネルギー</th><th scope="col">重さ</th></tr>
      </thead>
      <tbody>
        {
          withW.map((p) => (
            <tr data-k={p.key}>
              <th scope="row"><span class="pfc__chip">{p.short}</span>{p.name}</th>
              <td class="mono">{p.pct}%</td>
              <td class="mono">{fmtG(p.g)}（{Math.round(p.wPct)}%）</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</FigFrame>

<style>
  .pfc {
    display: grid;
    gap: var(--space-4);
    --p: var(--ai);
    --f: var(--shu-text);
    --c: var(--paper-3);
  }

  [data-k='p'] { --k: var(--p); --k-text: var(--paper); }
  [data-k='f'] { --k: var(--f); --k-text: var(--paper); }
  [data-k='c'] { --k: var(--c); --k-text: var(--ink); }

  .pfc__per {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    font-family: var(--font-gothic);
    font-size: var(--fs-sm);
  }

  .pfc__per li {
    display: flex;
    align-items: center;
    gap: 0.4em;
  }

  .pfc__per-n {
    font-size: var(--fs-xs);
    color: var(--ink-2);
  }

  .pfc__chip {
    display: inline-grid;
    place-items: center;
    inline-size: 1.4em;
    block-size: 1.4em;
    margin-inline-end: 0.4em;
    background: var(--k);
    color: var(--k-text);
    border: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    line-height: 1;
  }

  .pfc__per .pfc__chip {
    margin-inline-end: 0;
  }

  .pfc__row {
    display: grid;
    gap: var(--space-1);
  }

  .pfc__label {
    font-family: var(--font-gothic);
    font-size: var(--fs-sm);
    letter-spacing: 0.08em;
  }

  .pfc__bar {
    display: flex;
    block-size: 2.4rem;
    border: 1.5px solid var(--ink);
  }

  .pfc__bar span {
    display: grid;
    place-items: center;
    inline-size: var(--w);
    background: var(--k);
    color: var(--k-text);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    white-space: nowrap;
    overflow: hidden;
  }

  .pfc__bar span + span {
    border-inline-start: 1.5px solid var(--ink);
  }

  .pfc__table {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }

  .pfc__table th,
  .pfc__table td {
    padding: var(--space-1) var(--space-2) var(--space-1) 0;
    border-block-end: 1px solid var(--rule);
    text-align: start;
    font-weight: 500;
  }

  .pfc__table thead th {
    font-family: var(--font-gothic);
    font-size: var(--fs-xs);
    color: var(--ink-2);
    border-block-end-color: var(--ink);
  }

  .pfc__table tbody th {
    font-weight: 800;
  }
</style>
