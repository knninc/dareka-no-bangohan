---
import FigFrame from './FigFrame.astro';
/** 図：よくある思い込みの正誤表 */
const rows = [
  ['必須栄養素は33種類ある', '33は評価のための項目の数。減らしたい項目も、必須かどうか議論のある項目も入っている。'],
  ['PFCのバランスが理想なら健康', 'ビタミン、ミネラル、食物繊維、脂質の質は、別に確かめる必要がある。'],
  ['脳のために、砂糖を食べるべき', '脳がブドウ糖を使うことと、砂糖を食べる必要があることは別の話。'],
  ['脂質は、なるべく減らす', '必須脂肪酸や、脂溶性ビタミンの吸収に必要。量と質を整える。'],
  ['植物油なら、不飽和脂肪酸が多い', 'ココナッツ油のように、飽和脂肪酸が多い植物油もある。'],
  ['n-6系は悪い脂肪酸', '必須脂肪酸のひとつ。ひとまとめに避けるものではない。'],
  ['疲れたら、ビタミンB群を多く摂れば元気になる', 'B群はエネルギーを取り出す反応を助けるが、それ自体はエネルギーにならない。不足か、睡眠などほかの理由かを分ける。'],
  ['抗酸化ビタミンは、多いほどよい', 'サプリメントの大量摂取で、健康上の利益が増えるとは限らない。'],
  ['海藻はミネラルだから、たくさん食べるほどよい', '昆布などは、少しの量でもヨウ素が多くなりすぎることがある。'],
  ['成分表の100gの値が高い食品ほど優秀', '一回に食べる量、調理での損失、吸収率まで比べてはじめて意味がある。'],
];
---

<FigFrame no={7} title="よくある思い込みの、正誤表">
  <table class="errata">
    <thead>
      <tr>
        <th scope="col" class="errata__h-wrong">誤</th>
        <th scope="col" class="errata__h-right">正</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map(([w, r]) => (
          <tr>
            <td class="errata__wrong">{w}</td>
            <td class="errata__right">{r}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</FigFrame>

<style>
  .errata {
    inline-size: 100%;
    border-collapse: collapse;
    border-block: 1.5px solid var(--ink);
  }

  .errata th {
    padding-block: var(--space-2);
    border-block-end: 1px solid var(--ink);
    font-family: var(--font-gothic);
    font-weight: 500;
    font-size: var(--fs-sm);
    letter-spacing: 0.4em;
    text-align: start;
  }

  .errata__h-wrong {
    color: var(--ink-2);
    inline-size: 38%;
  }

  .errata__h-right {
    color: var(--shu-text);
  }

  .errata td {
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
    border-block-end: 1px solid var(--rule);
    vertical-align: top;
    font-size: var(--fs-sm);
    line-height: 1.7;
  }

  .errata__wrong {
    color: var(--ink-2);
    text-decoration: line-through;
    text-decoration-color: color-mix(in srgb, var(--shu) 70%, transparent);
    text-decoration-thickness: 1.5px;
  }

  .errata__right {
    font-weight: 800;
  }

  @media (max-width: 30rem) {
    .errata thead {
      display: none;
    }
    .errata tr {
      display: grid;
      padding-block: var(--space-3);
      border-block-end: 1px solid var(--rule);
    }
    .errata td {
      padding: 0;
      border: 0;
    }
    .errata__wrong::before {
      content: '誤　';
      font-family: var(--font-gothic);
      text-decoration: none;
      display: inline-block;
    }
    .errata__right::before {
      content: '正　';
      font-family: var(--font-gothic);
      font-weight: 500;
      color: var(--shu-text);
    }
  }
</style>
